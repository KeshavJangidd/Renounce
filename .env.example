# Renounce Environment Configuration
PORT=3001
NODE_ENV=development
SESSION_SECRET=renounce-session-secret-change-in-production

# Google OAuth 2.0 Credentials (Optional)
# If provided, Renounce authenticates against Google's live production OAuth servers.
# If omitted, Renounce provides an instant Google Account Chooser with simulated Google Auth.
# Authorized Redirect URI in Google Cloud Console: https://<your-render-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

